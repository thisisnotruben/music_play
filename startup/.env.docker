# Database
DB_HOST=database

DATA_MANIFEST_PATH=/etc/data.json

# Search
SEARCH_HOST=http://search
SEARCH_CONFIG_PATH=/etc/music-play-config.zip

# Storage
STORAGE_HOST=http://storage
STORAGE_PLAYLIST_TAR_PATH=/etc/data.tar
STORAGE_AUDIO_TAR_PATH=/etc/audioData.tar

# Auth
AUTH_HEALTH_CHECK_URL=http://auth:9000/health/ready
AUTH_JWK_SET_URI=http://auth:8080/realms/music-play/protocol/openid-connect/certs
AUTH_API_URL=http://auth:8080

# Message
RABBIT_HOST=message
